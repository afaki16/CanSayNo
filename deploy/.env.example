# Kopyala: cp .env.example .env  →  doldur  →  chmod 600 .env
# Rastgele değer üretmek için: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Veritabanı (yalnızca konteynerler arası; dışarı açık değil)
POSTGRES_USER=cansayno
POSTGRES_PASSWORD=

# JWT imza anahtarı — en az 32 karakter; değişirse herkes yeniden giriş yapar
JWT_SECRET=

# console.anthropic.com → API Keys (sunucu için AYRI bir anahtar aç, harcama limiti koy)
ANTHROPIC_API_KEY=

# RevenueCat → Integrations → Webhooks → Authorization header değeri (kendin üret)
REVENUECAT_WEBHOOK_AUTH=

# Brevo → SMTP & API → SMTP sekmesi (kullanıcı adı = Brevo'nun verdiği login, şifre = SMTP key)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cansayno.com

# E-postadaki linklerin gideceği site
FRONTEND_URL=https://cansayno.com

# İLK açılışta panel hesapları (superadmin@cansayno.com / admin@cansayno.com) bu şifrelerle oluşur.
# En az 12 karakter. İlk başarılı açılıştan sonra bu iki satırı boşalt ve şifreleri parola yöneticine kaydet.
INITIAL_SUPERADMIN_PASSWORD=
INITIAL_ADMIN_PASSWORD=
